# Copie para .env e ajuste se quiser, estes valores já funcionam pro dev local.
POSTGRES_DB=rolo35
POSTGRES_USER=rolo35
POSTGRES_PASSWORD=rolo35

# Segredo de assinatura do JWT — obrigatório, sem fallback no código (non-negotiable
# de segredo). Gere o seu, ex.: `openssl rand -base64 48`. Em produção (Render),
# configure como variável de ambiente do serviço, nunca commitado.
JWT_SECRET=troque-por-um-segredo-aleatorio-de-verdade-so-pra-dev-local

# Segredo de assinatura do código de ingresso (HMAC-SHA256) — obrigatório, sem
# fallback no código, e deliberadamente DISTINTO do JWT_SECRET (protegem coisas
# diferentes: sessão de usuário vs. autenticidade do ingresso/QR). Gere o seu,
# ex.: `openssl rand -base64 48`. Em produção (Render), configure como variável
# de ambiente do serviço, nunca commitado.
TICKET_HMAC_SECRET=troque-por-outro-segredo-aleatorio-de-verdade-distinto-do-jwt

# Origens permitidas por CORS na API, separadas por vírgula. Default já cobre o
# Vite dev local; em produção, aponte pra URL da Vercel.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Token do TMDb — obrigatório, sem fallback no código (mesmo non-negotiable do
# JWT_SECRET). É o API Read Access Token (v4, JWT longo), não a api_key legada
# (v3). Gere o seu em https://www.themoviedb.org/settings/api.
TMDB_API_TOKEN=troque-pelo-seu-api-read-access-token-v4-do-tmdb

# Fuso horário da API e do banco. sessoes.data_hora é wall-clock sem zona (o front envia a
# hora local do organizador direto do <input type="datetime-local">), então JVM, Postgres e
# navegador precisam concordar. Em produção (Render), configure a mesma variável no serviço —
# sem ela o container roda em UTC e rejeita como "no passado" qualquer horário nas próximas 3h.
TZ=America/Sao_Paulo

# Janela em que a portaria pode ativar uma sessão como "sessão do turno": quantos minutos antes do
# horário dela e quantas horas depois. Os defaults (30 e 2) são a regra de operação real — ativar a
# sessão errada faz a fila inteira ser recusada com ingresso legítimo na mão.
#
# Aqui vai alargado de propósito: todo seed nasce com data futura (dias à frente), então com o
# default nenhuma sessão semeada é selecionável e a tela da portaria fica inalcançável sem esperar o
# relógio. 20160 minutos = 14 dias, que cobre tudo que o seed cria. Em produção, deixe o default.
PORTARIA_JANELA_ANTES_MINUTOS=20160
PORTARIA_JANELA_DEPOIS_HORAS=2

# URL da API que o front chama. Lida em tempo de BUILD: o Vite inlina o valor no bundle, então
# mudá-la exige `docker compose up -d --build web`, não só um restart. Fica na raiz porque é
# daqui que o docker-compose.yml a lê como build arg — `web/.env` só vale pro `vite dev`.
VITE_API_URL=http://localhost:8080
